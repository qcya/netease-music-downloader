{
  "name": "netease-music-desktop-electron",
  "version": "3.0.7",
  "private": true,
  "description": "青春沿岸の音乐播放器：INS 覆盖层、网易云与桌面歌词",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run check && node scripts/write_build_info.js && npm run build:native && npm run build:backend && npm run build:muonium && npm run build:lyric && electron-builder --win zip --x64",
    "check": "node scripts/check_js.js",
    "build:backend": "py -3.12 scripts/build_backend.py",
    "test": "node --test tests/*.js",
    "build:muonium": "py -3.12 scripts/build_muonium_backend.py",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_native.ps1",
    "build:lyric": "py -3.12 scripts/build_lyric_aligner.py"
  },
  "devDependencies": {
    "electron": "37.3.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "top.qcya.netease.music.desktop",
    "productName": "青春沿岸の音乐播放器",
    "artifactName": "青春沿岸の音乐播放器-${version}-win64.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "source_availability.js",
      "taste_discovery.js",
      "app_logger.js",
      "online_media.js",
      "netease_account.js",
      "official_login_window.js",
      "netease_api_client.js",
      "netease_api_worker.js",
      "build-info.json",
      "discovery_service.js",
      "popular_playlists.js",
      "library_roots.js",
      "durable_json.js",
      "main.js",
      "app_lifecycle.js",
      "local_playlist.js",
      "user_playlists.js",
      "playlist_categories.js",
      "local_import.js",
      "local_covers.js",
      "download_queue.js",
      "floating_window.js",
      "lyric_position.js",
      "lyric_first_position.js",
      "floating-preload.js",
      "lyric_preferences.js",
      "backend_runtime.js",
      "preload.js",
      "app/**/*",
      "assets/**/*",
      "package.json",
      "playlist_reader.js",
      "recent_discovery.js",
      "music_providers.js",
      "fullscreen_player.js",
      "fullscreen-preload.js",
      "muonium_api_client.js",
      "netease_service.js",
      "original_account_api.js",
      "desktop_overlay.js",
      "native_glass.js",
      "startup_settings.js",
      "startup_notice.js",
      "portable_storage.js",
      "playback_session.js",
      "native_blur.js",
      "player_theme.js",
      "audio_quality.js",
      "window_stack.js",
      "lyric_alignment.js"
    ],
    "extraResources": [
      {
        "from": "skill",
        "to": "skill"
      },
      {
        "from": "assets/app.ico",
        "to": "app.ico"
      },
      {
        "from": "backend/music_backend.exe",
        "to": "backend/music_backend.exe"
      },
      {
        "from": "backend/muonium",
        "to": "backend/muonium"
      },
      {
        "from": "backend/neutral_composition.dll",
        "to": "backend/neutral_composition.dll"
      },
      {
        "from": "backend/lyric-aligner",
        "to": "backend/lyric-aligner"
      }
    ],
    "extraFiles": [
      { "from": "agent.cmd", "to": "agent.cmd" },
      { "from": "AGENTS.md", "to": "AGENTS.md" },
      { "from": "SKILL.md", "to": "SKILL.md" },
      { "from": "README.md", "to": "README.md" },
      { "from": "skills", "to": "skills" }
    ],
    "win": {
      "icon": "assets/app.ico",
      "executableName": "青春沿岸の音乐播放器",
      "target": [
        "zip"
      ]
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "afterPack": "scripts/after_pack.js"
  },
  "overrides": {
    "basic-ftp": "6.2.5"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "koffi": "2.15.2"
  }
}
