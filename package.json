{
  "name": "netease-music-desktop-electron",
  "version": "2.0.0",
  "private": true,
  "description": "粉蓝网易云音乐下载器：流式MP3试听、外挂桌面歌词、独立收藏路径、任务管理和AI Skill",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "check": "node --check main.js && node --check preload.js && node --check floating-preload.js && node --check download_queue.js && node --check floating_window.js && node --check app/lrc.js && node --check app/renderer.js && node --check app/floating-lyrics.js"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "top.qcya.netease.music.desktop",
    "productName": "网易云音乐下载器",
    "artifactName": "MusicDownloader-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "download_queue.js",
      "floating_window.js",
      "floating-preload.js",
      "preload.js",
      "app/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "skill",
        "to": "skill"
      },
      {
        "from": "assets/app.ico",
        "to": "app.ico"
      }
    ],
    "win": {
      "icon": "assets/app.ico",
      "executableName": "MusicDownloader",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "MusicDownloader-${version}-portable.exe"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
