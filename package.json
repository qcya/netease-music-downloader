{
  "name": "netease-music-desktop-electron",
  "version": "2.0.0-preview.6",
  "private": true,
  "description": "音乐下载器：顶部悬绳播放器、淡蓝粉白界面与独立全屏歌词",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run check && node scripts/write_build_info.js && npm run build:backend && electron-builder --win portable --x64",
    "check": "node scripts/check_js.js",
    "build:backend": "py -3.12 scripts/build_backend.py",
    "test": "node --test tests/*.js"
  },
  "devDependencies": {
    "electron": "37.3.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "top.qcya.netease.music.desktop",
    "productName": "音乐下载器",
    "artifactName": "MusicDownloader-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "source_availability.js",
      "taste_discovery.js",
      "app_logger.js",
      "online_media.js",
      "build-info.json",
      "discovery_service.js",
      "library_roots.js",
      "durable_json.js",
      "main.js",
      "app_lifecycle.js",
      "local_playlist.js",
      "playlist_categories.js",
      "local_import.js",
      "download_queue.js",
      "floating_window.js",
      "lyric_position.js",
      "floating-preload.js",
      "lyric_preferences.js",
      "backend_runtime.js",
      "preload.js",
      "app/**/*",
      "assets/**/*",
      "package.json",
      "playlist_reader.js",
      "recent_discovery.js",
      "top_panel.js",
      "charm-preload.js",
      "music_providers.js",
      "fullscreen_player.js",
      "fullscreen-preload.js"
    ],
    "extraResources": [
      {
        "from": "skill",
        "to": "skill"
      },
      {
        "from": "assets/app.ico",
        "to": "app.ico"
      },
      {
        "from": "backend/music_backend.exe",
        "to": "backend/music_backend.exe"
      }
    ],
    "win": {
      "icon": "assets/app.ico",
      "executableName": "MusicDownloader",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "MusicDownloader-${version}-portable.exe",
      "unpackDirName": true
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
